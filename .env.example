# Copy to .env  (the setup script does this automatically):  cp .env.example .env

# ─── Database ────────────────────────────────────────────
POSTGRES_USER=carfinder
POSTGRES_PASSWORD=carfinder
POSTGRES_DB=carfinder
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://carfinder:carfinder@localhost:5432/carfinder

# ─── Local AI (Ollama) ───────────────────────────────────
OLLAMA_HOST=http://localhost:11434
LLM_TEXT_MODEL=qwen2.5:14b
LLM_VISION_MODEL=llama3.2-vision:11b
LLM_EMBED_MODEL=nomic-embed-text

# ─── Scraping ────────────────────────────────────────────
# Craigslist subregions: SF Bay + driveable NorCal
CL_REGIONS=sfbay,sacramento,santacruz,monterey,stockton
CL_MIN_DELAY_SEC=3
CL_MAX_DELAY_SEC=8

# ─── eBay Browse API  (free key: https://developer.ebay.com) ───
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=PRODUCTION

# ─── Frontend ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ─── Alerts (optional) ───────────────────────────────────
# An ntfy.sh topic URL or a Discord webhook URL; alerts fire at/above ALERT_MIN_SCORE
ALERT_NTFY_TOPIC=
ALERT_DISCORD_WEBHOOK=
ALERT_MIN_SCORE=8
